# --- RSS Feeds ---
# Format: url|Topic;url2|Topic2 — leave blank to use built-in defaults
# Default feeds: DVZ, Verkehrs-Rundschau, FreightWaves, Transport Topics, Logistik Heute
RSS_FEEDS=
RSS_MAX_PER_FEED=20

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_WRITER_MODEL=qwen2.5:14b-instruct      # best free German quality (needs ~16GB VM)
OLLAMA_IMAGE_PROMPT_MODEL=llama3.2:3b
OLLAMA_REQUEST_TIMEOUT=600

# --- Content ---
POST_LANGUAGE=German
MAX_ARTICLES=10

# --- Images (Pollinations) ---
IMAGE_WIDTH=1200
IMAGE_HEIGHT=627
IMAGE_MODEL=flux
POLLINATIONS_BASE=https://image.pollinations.ai/prompt

# --- Storage ---
DB_PATH=/data/posts.db
IMAGE_DIR=/data/images

# --- Knowledge Base (RAG) ---
EMBED_MODEL=nomic-embed-text
KB_PATH=/data/chroma
KB_MIN_EXAMPLES=3
STYLE_GUIDE_PATH=/data/style_guide

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=change-me
GENERIC_TIMEZONE=Europe/Berlin
# Once the Cloudflare Tunnel hostname for n8n is live, set this to that URL
# (e.g. https://n8n.yourdomain.com) so n8n generates correct webhook URLs.
WEBHOOK_URL=http://localhost:5678

# --- Cloudflare Tunnel (public access without exposed ports) ---
# 1. Cloudflare Zero Trust dashboard → Networks → Tunnels → Create a tunnel → cloudflared
# 2. Copy the token shown during setup (starts with "ey...") and paste it below
# 3. Configure Public Hostnames for the tunnel in the dashboard — see
#    ROTEIRO_IMPLEMENTACAO.md / project docs for the exact list to add
CLOUDFLARE_TUNNEL_TOKEN=

# --- CORS (needed by cloudflare-dashboard/, a static site on another origin) ---
# Comma-separated list of allowed origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://dashboard.yourdomain.com
CORS_ALLOWED_ORIGINS=

# --- Offline-friendly request queue (cloudflare-worker/) ---
# Lets a colleague click "Gerar Posts" even while this machine is off; the
# request waits in the Worker's KV store until engine-api polls it back
# online. See cloudflare-worker/README.md for deploy steps. Leave
# QUEUE_WORKER_URL blank to disable the poller entirely (default/no-op).
QUEUE_WORKER_URL=
# Must match exactly what you set via: wrangler secret put QUEUE_SHARED_SECRET
QUEUE_SHARED_SECRET=
QUEUE_POLL_INTERVAL_SECONDS=60

# --- Phase 2 LinkedIn (leave blank / disabled for now) ---
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202505
