# --- RSS-Feeds ---
# Format: url|Topic;url2|Topic2 — leer lassen, um die eingebauten Standard-Feeds zu nutzen
# Standard-Feeds (engine-api/rss.py): Logistik Heute, Logistra, Logistik News24, Eurotransport,
# MM Logistik, Logistik Express, Destatis, Bundesnetzagentur, BALM, EUR-Lex, DG MOVE, BMAS
RSS_FEEDS=
RSS_MAX_PER_FEED=20

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_WRITER_MODEL=qwen2.5:14b-instruct      # beste kostenlose Qualität auf Deutsch (braucht ~16-GB-VM)
OLLAMA_IMAGE_PROMPT_MODEL=llama3.2:3b
OLLAMA_REQUEST_TIMEOUT=600
# Optional: eigener Ollama-Host nur für Embeddings (lokal z. B. http://ollama:11434, wenn
# OLLAMA_HOST auf das native Ollama des Host-Rechners zeigt). Leer = OLLAMA_HOST.
OLLAMA_EMBED_HOST=

# Schritt 3d — deutsches Korrekturmodell (Grammatik, Rechtschreibung, Zeichensetzung).
# Einmalig laden: ollama pull hf.co/jeorgesilva/llama3.1-german-corrector-q4
# Leer lassen, um die Korrektur zu deaktivieren. OLLAMA_CORRECTOR_HOST leer = OLLAMA_HOST.
OLLAMA_CORRECTOR_MODEL=hf.co/jeorgesilva/llama3.1-german-corrector-q4
OLLAMA_CORRECTOR_HOST=

# --- Inhalt ---
POST_LANGUAGE=German
MAX_ARTICLES=10

# --- Bilder (Pollinations) ---
IMAGE_WIDTH=1200
IMAGE_HEIGHT=627
IMAGE_MODEL=flux
POLLINATIONS_BASE=https://image.pollinations.ai/prompt

# --- Speicher ---
DB_PATH=/data/posts.db
IMAGE_DIR=/data/images

# --- Knowledge Base (RAG) ---
EMBED_MODEL=nomic-embed-text
KB_PATH=/data/chroma
KB_MIN_EXAMPLES=3
STYLE_GUIDE_PATH=/data/style_guide

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=change-me
GENERIC_TIMEZONE=Europe/Berlin
# Sobald ein öffentlicher Hostname für n8n existiert, hier diese URL eintragen
# (z. B. https://n8n.yourdomain.example), damit n8n korrekte Webhook-URLs erzeugt.
WEBHOOK_URL=http://localhost:5678

# --- Cloudflare Tunnel (benannter Tunnel per Token) ---
# Derzeit UNGENUTZT: docker-compose.yml startet cloudflared im Quick-Tunnel-Modus
# (zufälliger *.trycloudflare.com-Hostname, kein Token nötig) und liest diese Variable nicht.
# Nur relevant, falls wieder auf einen benannten Tunnel umgestellt wird:
# 1. Cloudflare-Zero-Trust-Dashboard → Networks → Tunnels → Create a tunnel → cloudflared
# 2. Das beim Einrichten angezeigte Token (beginnt mit "ey...") kopieren und unten einfügen
# 3. Im Dashboard die Public Hostnames für den Tunnel konfigurieren
CLOUDFLARE_TUNNEL_TOKEN=

# --- CORS (benötigt von cloudflare-dashboard/, einer statischen Seite auf einem anderen Origin) ---
# Kommagetrennte Liste erlaubter Origins, z. B.:
# CORS_ALLOWED_ORIGINS=https://dashboard.yourdomain.example
CORS_ALLOWED_ORIGINS=

# --- Warteschlange für Anfragen bei ausgeschaltetem Rechner (cloudflare-worker/) ---
# Ermöglicht einem Teammitglied, auf „Posts generieren“ zu klicken, auch wenn dieser Rechner aus
# ist; die Anfrage wartet im KV-Store des Workers, bis die engine-api sie abholt, sobald sie
# wieder online ist. Deploy-Schritte siehe cloudflare-worker/README.md. QUEUE_WORKER_URL leer
# lassen, um den Poller komplett zu deaktivieren (Standard/No-op).
QUEUE_WORKER_URL=
# Muss exakt dem Wert entsprechen, der mit „wrangler secret put QUEUE_SHARED_SECRET“ gesetzt wurde
QUEUE_SHARED_SECRET=
QUEUE_POLL_INTERVAL_SECONDS=60

# --- Phase 2: LinkedIn (vorerst leer lassen / deaktiviert) ---
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202505
