# --- RSS Feeds ---
# Format: url|Topic;url2|Topic2 — leave blank to use built-in defaults
# Default feeds: DVZ, Verkehrs-Rundschau, FreightWaves, Transport Topics, Logistik Heute
RSS_FEEDS=
RSS_MAX_PER_FEED=20

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_WRITER_MODEL=qwen2.5:14b-instruct      # best free German quality (needs ~16GB VM)
OLLAMA_IMAGE_PROMPT_MODEL=llama3.2:3b
OLLAMA_REQUEST_TIMEOUT=600

# --- Content ---
POST_LANGUAGE=German
MAX_ARTICLES=10

# --- Images (Pollinations) ---
IMAGE_WIDTH=1200
IMAGE_HEIGHT=627
IMAGE_MODEL=flux
POLLINATIONS_BASE=https://image.pollinations.ai/prompt

# --- Storage ---
DB_PATH=/data/posts.db
IMAGE_DIR=/data/images

# --- Knowledge Base (RAG) ---
EMBED_MODEL=nomic-embed-text
KB_PATH=/data/chroma
KB_MIN_EXAMPLES=3
STYLE_GUIDE_PATH=/data/style_guide

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=change-me
GENERIC_TIMEZONE=Europe/Berlin
WEBHOOK_URL=http://localhost:5678

# --- Phase 2 LinkedIn (leave blank / disabled for now) ---
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202505
